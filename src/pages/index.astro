---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { site } from "../config";

const posts = (await getCollection("posts", ({ data }) => (import.meta.env.PROD ? data.draft !== true : true))).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base title={site.title} description={site.description}>
  <section class="intro">
    <h1>Pravash Karki</h1>
    <p>Product designer and technology consultant in Kathmandu, Nepal. Twenty years across graphic and web design, front-end, SEO, brand strategy and enterprise product design. Founder of <a href="https://lastdoorsolutions.com">LastDoor</a>; currently consulting for Highstep Technologies (USA); training as a psychosocial counselor. <a href="/about/">Full profile</a> · <a href="/products/">Products</a></p>
  </section>

  <section class="post-list">
    <h2>Essays</h2>
    {posts.length === 0 && <p class="muted">First essays are being written. Subscribe by <a href="/rss.xml">RSS</a>.</p>}
    {posts.map((post) => (
      <article>
        <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
        <time datetime={post.data.date.toISOString().slice(0, 10)}>
          {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        </time>
        <p class="muted">{post.data.description}</p>
      </article>
    ))}
  </section>

  <section class="projects">
    <h2>Products</h2>
    <ul>
      <li><a href="/app/mano/">Mano</a><span>Free offline app for noticing how you feel, Nepali and English. Android and iOS, 2026.</span></li>
      <li><a href="https://pcs.pravashkarki.com">Mano Atlas</a><span>Bilingual mental-health education from the CTEVT Psychosocial Counselor course.</span></li>
      <li><a href="https://github.com/pravashkarki/inkwell">inkwell</a><span>Open-source Markdown blog template. This site runs on it.</span></li>
      <li><a href="/products/">All products and open source</a><span>BattiGayo, Medibook, Sampression themes, Neptees, and more.</span></li>
    </ul>
  </section>
</Base>
