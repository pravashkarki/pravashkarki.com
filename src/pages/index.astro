---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { site } from "../config";

const posts = (await getCollection("posts", ({ data }) => (import.meta.env.PROD ? data.draft !== true : true))).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base title={site.title} description={site.description}>
  <a class="featured" href="/app/mano/">
    <img src="/mark.svg" alt="" width="44" height="44" />
    <span>
      <strong>Mano · मनो</strong>
      A small, free app for noticing how you feel, in Nepali and English. Everything stays on your phone. Android and iOS, coming soon.
    </span>
  </a>

  <section class="intro">
    <h1>Pravash Karki</h1>
    <p>Product designer and technology consultant in Kathmandu. Twenty years across design, front-end, SEO and product; founder of <a href="https://lastdoorsolutions.com">LastDoor</a>, co-founder of <a href="https://neptees.com">Neptees</a>, and training as a psychosocial counselor. Currently leading design for an enterprise data platform at Highstep Technologies (USA). <a href="/about/">More about me</a>.</p>
  </section>

  <section class="projects">
    <h2>Projects</h2>
    <ul>
      <li><a href="/app/mano/">Mano app</a><span>Offline feelings log with two-minute coping skills and verified Nepal helplines. No account, no tracking.</span></li>
      <li><a href="https://pcs.pravashkarki.com">Mano Atlas · मनो एट्लास</a><span>Free bilingual mental-health education: 29 chapters from the CTEVT Psychosocial Counselor course, for students, families and anyone learning.</span></li>
      <li><a href="https://lastdoorsolutions.com">LastDoor</a><span>Since 2006. Design-driven technology practice: enterprise Drupal and WordPress, brand, AI automation, for clients worldwide.</span></li>
      <li><a href="https://github.com/pravashkarki/inkwell">inkwell</a><span>Open-source blog template for serious writers: Markdown in, clean HTML out, every post also served as raw Markdown. This site runs on it.</span></li>
      <li><a href="https://neptees.com">Neptees</a><span>Co-founder. Graphic tees made in Nepal: wear your pride, wear Nepali.</span></li>
      <li><a href="https://lastdoorsolutions.com/battigayo/">BattiGayo</a><span>2012 to 2018. The iOS app Nepal used to plan around load shedding, published by Idealaya. Retired when the power cuts ended.</span></li>
      <li><a href="https://profiles.wordpress.org/sampression/">Sampression themes</a><span>Free WordPress themes on WordPress.org since 2012: Sampression Lite, Naya Lite, Finedine.</span></li>
    </ul>
  </section>

  {posts.length > 0 && (
    <section class="post-list">
      <h2>Writing</h2>
      {posts.map((post) => (
        <article>
          <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
          <time datetime={post.data.date.toISOString().slice(0, 10)}>
            {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </time>
        </article>
      ))}
    </section>
  )}
</Base>
