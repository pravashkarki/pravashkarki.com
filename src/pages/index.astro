---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { site } from "../config";

const posts = (await getCollection("posts", ({ data }) => (import.meta.env.PROD ? data.draft !== true : true))).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const products = [
  { href: "/app/mano/", name: "Mano", year: "2026", note: "Offline feelings log with coping skills and helplines, in Nepali and English, made in Nepal for anyone. Coming soon." },
  { href: "https://pcs.pravashkarki.com", name: "Mano Atlas", year: "2026", note: "Bilingual mental-health education, 29 chapters." },
  { href: "https://github.com/pravashkarki/inkwell", name: "inkwell", year: "2026", note: "Markdown blog template. This site runs on it." },
];
---

<Base title={site.title} description={site.description}>
  <section class="intro">
    <h1>Twenty years of making things people can use. Now writing about it.</h1>
    <p class="trust"><a href="https://credentials.edx.org/credentials/7906d7bb5f9944e3a57630d86cf49196/">HCI certificate, Georgia Institute of Technology</a> · Founder of <a href="https://lastdoorsolutions.com">LastDoor</a> since 2006 · co-founder of <a href="https://www.idealaya.com">Idealaya</a> and <a href="https://neptees.com">Neptees</a> · consulting on an enterprise data platform for <a href="https://highstep.com">Highstep Technologies</a> (USA) · <a href="https://www.upwork.com/freelancers/~0153c9090872bf885f">5.0 across 71 client reviews on Upwork</a> · MSc, London Metropolitan University · training as a psychosocial counselor.</p>
  </section>

  <section class="post-list" id="essays">
    <h2>Essays</h2>
    {posts.length === 0 && (
      <div class="empty">
        <p>The first essays are being written: on design that stays out of the way, on building software from Kathmandu for the world, and on mental health in Nepal.</p>
        <p><a class="button" href="/rss.xml">Get them first by RSS</a></p>
      </div>
    )}
    {posts.map((post) => (
      <article>
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{post.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "2-digit" })}</time>
        <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
        <p class="muted">{post.data.description}</p>
      </article>
    ))}
  </section>

  <section class="products">
    <h2>Products</h2>
    <ul>
      {products.map((p) => (
        <li><span class="year">{p.year}</span><span><a href={p.href}>{p.name}</a><span class="note">{p.note}</span></span></li>
      ))}
    </ul>
    <p class="muted more"><a href="/products/">All products and open source</a></p>
  </section>
</Base>
